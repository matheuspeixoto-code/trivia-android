<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== Texto ========== -->
    <style name="TextAppearance.Trivia.Wordmark" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">64sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textColor">@color/trivia_ink</item>
    </style>

    <style name="TextAppearance.Trivia.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/trivia_ink</item>
    </style>

    <style name="TextAppearance.Trivia.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/trivia_ink</item>
    </style>

    <style name="TextAppearance.Trivia.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/trivia_ink</item>
    </style>

    <style name="TextAppearance.Trivia.Muted" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/trivia_ink_muted</item>
    </style>

    <style name="TextAppearance.Trivia.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/trivia_ink_muted</item>
    </style>

    <style name="TextAppearance.Trivia.Question" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/trivia_ink</item>
    </style>

    <!-- ========== Botões ========== -->
    <style name="Widget.Trivia.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Trivia.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/trivia_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- ========== Campo de texto ========== -->
    <style name="Widget.Trivia.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/trivia_primary</item>
    </style>

    <!-- ========== Spinner (lista suspensa) ========== -->
    <style name="Widget.Trivia.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">48dp</item>
        <item name="android:popupBackground">@color/trivia_surface</item>
    </style>

</resources>
