<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/txtTituloResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fim de jogo!"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/txtNomeJogador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jogador: Matheus"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumo da partida"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtTotalQuestoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantidade de questões: 10"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtAcertos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acertos: 8"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtErros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Erros: 2"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtPontuacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pontuação: 800 pontos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnJogarNovamente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jogar novamente"/>

    <Button
        android:id="@+id/btnVoltarMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voltar ao menu principal"
        android:layout_marginTop="12dp"/>

</LinearLayout>
