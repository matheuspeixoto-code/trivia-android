<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trivia_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/txtBoasVindas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Bem-vindo!"
        android:textAppearance="@style/TextAppearance.Trivia.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="O que vamos fazer agora?"
        android:textAppearance="@style/TextAppearance.Trivia.Muted" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnJogar"
        style="@style/Widget.Trivia.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:text="Jogar"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="?attr/colorOnPrimary" />

    <Button
        android:id="@+id/btnHistorico"
        style="@style/Widget.Trivia.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="64dp"
        android:text="Histórico"
        app:icon="@drawable/ic_history"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="?attr/colorPrimary" />

</LinearLayout>
