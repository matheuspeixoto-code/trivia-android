<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/trivia_bg"
    android:fitsSystemWindows="true">

    <!-- Estado: carregando categorias -->
    <LinearLayout
        android:id="@+id/layoutCarregando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Carregando..."
            android:textAppearance="@style/TextAppearance.Trivia.Muted" />
    </LinearLayout>

    <!-- Estado: formulário -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutConfiguracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Configurar partida"
                android:textAppearance="@style/TextAppearance.Trivia.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="Categoria"
                android:textAppearance="@style/TextAppearance.Trivia.Label" />

            <Spinner
                android:id="@+id/spCategoria"
                style="@style/Widget.Trivia.Spinner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Dificuldade"
                android:textAppearance="@style/TextAppearance.Trivia.Label" />

            <Spinner
                android:id="@+id/spDificuldade"
                style="@style/Widget.Trivia.Spinner" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Trivia.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Quantidade de perguntas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtQuantidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:text="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/txtTempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tempo por pergunta: 30 segundos"
                android:textAppearance="@style/TextAppearance.Trivia.Label" />

            <SeekBar
                android:id="@+id/seekTempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="50"
                android:progress="20" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnIniciarPartida"
                style="@style/Widget.Trivia.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="64dp"
                android:text="Iniciar partida"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="?attr/colorOnPrimary" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
