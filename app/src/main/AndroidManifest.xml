<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trivia">
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.MenuActivity"
            android:exported="true" />

        <activity android:name=".activity.ConfiguracaoActivity" android:exported="true"/>
        <activity
            android:name=".activity.JogoActivity"
            android:exported="true" />

        <activity
            android:name=".activity.ResultadoActivity"
            android:exported="true" />

        <provider
            android:name=".provider.TriviaProvider"
            android:authorities="com.trivia.provider"
            android:exported="true" />

        <service
            android:name=".service.PartidaService"
            android:exported="true" />
    </application>

</manifest>