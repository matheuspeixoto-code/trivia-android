
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões necessárias para comunicação com a API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trivia">

        <!-- Tela inicial -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Menu principal -->
        <activity
            android:name=".activity.MenuActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Configuração da partida -->
        <activity
            android:name=".activity.ConfiguracaoActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Tela do jogo -->
        <activity
            android:name=".activity.JogoActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Resultado da partida -->
        <activity
            android:name=".activity.ResultadoActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Histórico de partidas -->
        <activity
            android:name=".activity.HistoricoActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Provedor de acesso ao banco SQLite -->
        <provider
            android:name=".provider.TriviaProvider"
            android:authorities="com.trivia.provider"
            android:exported="true" />

        <!-- Serviço responsável pelas partidas -->
        <service
            android:name=".service.PartidaService"
            android:exported="true" />

        <!-- Receptor de mudanças de conectividade -->
        <receiver
            android:name=".broadcast.ConexaoReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
